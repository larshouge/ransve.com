---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';

const om = await getEntry('sider', 'om');
if (!om) throw new Error('Mangler src/content/sider/om.md');
const { Content } = await render(om);
---
<Base title="Om kunstneren — Bjørn Ransve" description={om.data.merkelapp}>
  <Nav />
  <main>
    <PageHero kicker={om.data.merkelapp} heading={om.data.overskrift} portrettTekst={om.data.portrettTekst}>
      <Content />
    </PageHero>
  </main>
  <Footer />
</Base>
