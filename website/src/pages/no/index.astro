---
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import DecadePanel from '../../components/DecadePanel.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import { buildImageMap, resolveImage } from '../../lib/images';

const forside = await getEntry('sider', 'forside');
if (!forside) throw new Error('Mangler src/content/sider/forside.md');
const { Content: Ingress } = await render(forside);

// tidslinje.csv peker til bilder med filnavn alene — slå dem opp mot
// katalogen her, én gang, før panelene rendres.
const tidslinjeBilder = buildImageMap(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/tidslinje/*.{jpg,jpeg,png,webp}', { eager: true })
);

// Nyeste tiår først: 2020 → 1960.
const tiar = (await getCollection('tidslinje'))
  .sort((a, b) => a.data.rekkefolge - b.data.rekkefolge)
  .map((entry) => ({
    entry,
    bilde: resolveImage(tidslinjeBilder, entry.data.bildefil, `tidslinje.csv, rad "${entry.id}"`),
  }));
---
<Base title="Bjørn Ransve — maler og grafiker" description={forside.data.merkelapp}>
  <Nav />
  <main>
    <PageHero kicker={forside.data.merkelapp} heading={forside.data.overskrift} portrettTekst={forside.data.portrettTekst}>
      <Ingress />
    </PageHero>

    {tiar.map(({ entry, bilde }, i) => <DecadePanel entry={entry} bilde={bilde} eager={i === 0} />)}
  </main>
  <Footer />
  <Lightbox />
</Base>
