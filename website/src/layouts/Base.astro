---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description, lang = 'no' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#0F0F0D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Archivo+Narrow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --rv-bg: #0f0f0d;
    --rv-line: #2a2a26;
    --rv-text: #f9f7f3;
    --rv-body: #e8e2d0;
    --rv-muted: #b8b09a;
    --rv-faint: #5a5448;
    --rv-serif: 'EB Garamond', Georgia, serif;
    --rv-sans: 'Archivo Narrow', Arial, sans-serif;
    --rv-gutter: clamp(20px, 5vw, 48px);
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--rv-bg);
    color: var(--rv-text);
    font-family: var(--rv-sans);
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--rv-text);
  }
</style>
