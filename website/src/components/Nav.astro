---
const items = [
  { label: 'Hjem', href: '/no/' },
  { label: 'Verk', href: '/no/verk/' },
  { label: 'Om', href: '/no/om/' },
  { label: 'Kontakt', href: '/no/kontakt/' },
];
const current = Astro.url.pathname;
---
<nav class="nav">
  <a class="brand" href="/no/">RANSVE</a>
  <div class="links">
    {items.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    padding: 20px var(--rv-gutter);
    border-bottom: 1px solid var(--rv-line);
    position: sticky;
    top: 0;
    background: var(--rv-bg);
    z-index: 10;
  }
  .brand {
    font-family: var(--rv-serif);
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--rv-text);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    font-family: var(--rv-sans);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rv-muted);
  }
  .links a[aria-current='page'] {
    color: var(--rv-text);
  }
</style>
