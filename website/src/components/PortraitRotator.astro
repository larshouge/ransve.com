---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  caption: string;
}
const { caption } = Astro.props;

// Alle portretter i src/assets/portretter/ går i rotasjonen.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/portretter/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const portraits = Object.keys(files)
  .sort()
  .map((key) => files[key].default);
---
<figure class="portrait">
  <div class="frame" data-portrait-rotator data-interval="6000">
    {
      portraits.map((src, i) => (
        <Image
          src={src}
          alt={i === 0 ? 'Portrett av Bjørn Ransve' : ''}
          aria-hidden={i === 0 ? undefined : 'true'}
          widths={[280, 560]}
          sizes="280px"
          loading={i === 0 ? 'eager' : 'lazy'}
          class:list={['shot', { active: i === 0 }]}
        />
      ))
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // Tilfeldig startportrett ved hvert besøk, deretter nytt portrett hvert 6. sekund.
  for (const frame of document.querySelectorAll<HTMLElement>('[data-portrait-rotator]')) {
    const shots = Array.from(frame.querySelectorAll<HTMLImageElement>('.shot'));
    if (shots.length < 2) continue;
    const interval = Number(frame.dataset.interval) || 6000;
    let idx = Math.floor(Math.random() * shots.length);

    const show = (next: number) => {
      shots.forEach((img, i) => {
        const on = i === next;
        img.classList.toggle('active', on);
        img.alt = on ? 'Portrett av Bjørn Ransve' : '';
        if (on) img.removeAttribute('aria-hidden');
        else img.setAttribute('aria-hidden', 'true');
      });
      // Last neste bilde i forkant, så overgangen ikke venter på nettverket.
      shots[(next + 1) % shots.length].loading = 'eager';
    };

    show(idx);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        idx = (idx + 1) % shots.length;
        show(idx);
      }, interval);
    }
  }
</script>

<style>
  .portrait {
    flex: 1 1 220px;
    max-width: 280px;
    min-width: 180px;
    margin: 0;
  }
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.25, 0, 0, 1);
  }
  .shot.active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
  }
  figcaption {
    font-family: var(--rv-sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--rv-faint);
    margin-top: 10px;
  }
</style>
