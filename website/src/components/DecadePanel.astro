---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'tidslinje'>;
  eager?: boolean;
}
const { entry, eager = false } = Astro.props;
const { aar, tittel, bilde, alt, bildetekst } = entry.data;
const { Content } = await render(entry);
---
<section class="panel" aria-labelledby={`tiar-${entry.id}`}>
  <div class="media">
    <Image
      src={bilde}
      alt={alt}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 900px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="body">
    <h2 class="years" id={`tiar-${entry.id}`}>{aar}</h2>
    <div class="title">{tittel}</div>
    <div class="text"><Content /></div>
    <div class="caption">{bildetekst}</div>
  </div>
</section>

<style>
  .panel {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--rv-line);
  }
  .media {
    flex: 1 1 420px;
    min-width: 280px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
  }
  .body {
    flex: 1 1 420px;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: clamp(28px, 4vw, 56px);
  }
  .years {
    font-family: var(--rv-serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
    color: var(--rv-text);
    margin: 0;
  }
  .title {
    font-family: var(--rv-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--rv-muted);
    text-transform: uppercase;
  }
  .text :global(p) {
    font-family: var(--rv-serif);
    font-size: 15px;
    line-height: 1.75;
    color: var(--rv-body);
    max-width: 460px;
    margin: 0;
  }
  .caption {
    font-family: var(--rv-sans);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--rv-faint);
  }
</style>
