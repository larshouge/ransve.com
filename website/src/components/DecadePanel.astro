---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

interface Props {
  entry: CollectionEntry<'tidslinje'>;
  bilde: ImageMetadata;
  eager?: boolean;
}
const { entry, bilde, eager = false } = Astro.props;
const { aar, tittel, alt, bildetekst, tekst } = entry.data;
// tekst kan ha flere avsnitt skilt med blank linje i CSV-cellen.
const avsnitt = tekst
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
// Full oppløsning til lightboxen.
const full = await getImage({ src: bilde, width: 1600 });
---
<section class="panel" aria-labelledby={`tiar-${entry.id}`}>
  <button
    type="button"
    class="media"
    data-lightbox-trigger
    data-full={full.src}
    data-alt={alt}
    data-aar={aar}
    data-tittel={tittel}
    data-tekst={tekst}
    data-bildetekst={bildetekst}
    aria-haspopup="dialog"
    aria-label={`Vis ${tittel}, ${aar}, i full størrelse`}
  >
    <Image
      src={bilde}
      alt={alt}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 900px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </button>
  <div class="body">
    <h2 class="years" id={`tiar-${entry.id}`}>{aar}</h2>
    <div class="title">{tittel}</div>
    <div class="text">{avsnitt.map((p) => <p>{p}</p>)}</div>
    <div class="caption">{bildetekst}</div>
  </div>
</section>

<style>
  .panel {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--rv-line);
  }
  .media {
    flex: 1 1 420px;
    min-width: 280px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
    transition: transform 400ms ease;
  }
  .media:hover img,
  .media:focus-visible img {
    transform: scale(1.02);
  }
  .media:focus-visible {
    outline: 2px solid var(--rv-muted);
    outline-offset: -2px;
  }
  .body {
    flex: 1 1 420px;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: clamp(28px, 4vw, 56px);
  }
  .years {
    font-family: var(--rv-serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
    color: var(--rv-text);
    margin: 0;
  }
  .title {
    font-family: var(--rv-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--rv-muted);
    text-transform: uppercase;
  }
  .text p {
    font-family: var(--rv-serif);
    font-size: 15px;
    line-height: 1.75;
    color: var(--rv-body);
    max-width: 460px;
    margin: 0;
  }
  .text p + p {
    margin-top: 12px;
  }
  .caption {
    font-family: var(--rv-sans);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--rv-faint);
  }
</style>
