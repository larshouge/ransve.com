---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

interface Props {
  entry: CollectionEntry<'verk'>;
  bilde: ImageMetadata;
  eager?: boolean;
}
const { entry, bilde, eager = false } = Astro.props;
const { aar, tittel, teknikk, mal, alt, tekst_no, status, pris } = entry.data;

const detaljer = [teknikk, mal].filter(Boolean).join(' · ');

const statusLinje = (() => {
  const s = status.trim().toLowerCase();
  if (s === 'til salgs') return pris ? `Til salgs — ${pris}` : 'Til salgs';
  if (s === 'solgt') return 'Solgt';
  if (s === 'ikke til salgs') return 'Ikke til salgs';
  return status;
})();

// Full oppløsning til lightboxen.
const full = await getImage({ src: bilde, width: 1600 });
---
<button
  type="button"
  class="card"
  data-lightbox-trigger
  data-full={full.src}
  data-alt={alt}
  data-aar={aar}
  data-tittel={tittel}
  data-detaljer={detaljer}
  data-tekst={tekst_no}
  data-status={statusLinje}
  aria-haspopup="dialog"
  aria-label={`Vis ${tittel}, ${aar}, i full størrelse`}
>
  <div class="media">
    <Image
      src={bilde}
      alt={alt}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="caption">
    <span class="tittel">{tittel}</span>
    <span class="aar">{aar}</span>
  </div>
</button>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    color: inherit;
    font: inherit;
  }
  .media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--rv-line);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
    transition: transform 400ms ease;
  }
  .card:hover .media img,
  .card:focus-visible .media img {
    transform: scale(1.03);
  }
  .card:focus-visible {
    outline: 2px solid var(--rv-muted);
    outline-offset: 2px;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-top: 10px;
    font-family: var(--rv-sans);
  }
  .tittel {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--rv-text);
  }
  .aar {
    font-size: 12px;
    color: var(--rv-faint);
    white-space: nowrap;
  }
</style>
